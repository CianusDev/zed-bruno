#!/usr/bin/env node
// bruno-zed — run Bruno requests (.bru or OpenCollection .yml) from Zed tasks.
//
// Usage:
//   bruno-zed run <file>          run a single request
//   bruno-zed folder <path>       run every request of the folder (recursive)
//   bruno-zed collection <path>   run the whole collection containing <path>
//   bruno-zed env <path>          choose the environment used for this collection
//   bruno-zed view                open the Markdown response view in Zed
//   bruno-zed last                print the last response again
//
// Environment selection (first match wins):
//   1. BRUNO_ENV environment variable ("none" disables it)
//   2. choice saved with `bruno-zed env`
//   3. nothing -> bru uses the collection default (presets.defaultEnvironment)
//
// Extra args after `--` are passed to `bru run` as is.

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const readline = require('readline');
const { spawnSync } = require('child_process');

const STATE_DIR = path.join(process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state'), 'bruno-zed');
const STATE_FILE = path.join(STATE_DIR, 'envs.json');
const LAST_RESPONSE = path.join(STATE_DIR, 'last-response.json');
const LAST_REPORT = path.join(STATE_DIR, 'last-report.json');
const RESPONSE_MD = path.join(STATE_DIR, 'response.md');

const tty = process.stdout.isTTY;
const c = (code) => (s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : String(s));
const bold = c('1');
const dim = c('2');
const red = c('31');
const green = c('32');
const yellow = c('33');
const cyan = c('36');

function die(msg, code = 1) {
  console.error(red(`✗ ${msg}`));
  process.exit(code);
}

function findCollectionRoot(start) {
  let dir = fs.existsSync(start) && fs.statSync(start).isDirectory() ? start : path.dirname(start);
  dir = path.resolve(dir);
  for (;;) {
    if (fs.existsSync(path.join(dir, 'opencollection.yml'))) return { root: dir, format: 'yml' };
    if (fs.existsSync(path.join(dir, 'bruno.json'))) return { root: dir, format: 'bru' };
    const parent = path.dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

function readState() {
  try {
    return JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
  } catch {
    return {};
  }
}

function writeState(state) {
  fs.mkdirSync(STATE_DIR, { recursive: true });
  fs.writeFileSync(STATE_FILE, JSON.stringify(state, null, 2));
}

function listEnvironments(root, format) {
  const dir = path.join(root, 'environments');
  if (!fs.existsSync(dir)) return [];
  const ext = format === 'yml' ? ['.yml', '.yaml'] : ['.bru'];
  return fs
    .readdirSync(dir)
    .filter((f) => ext.includes(path.extname(f)))
    .map((f) => path.basename(f, path.extname(f)))
    .sort();
}

function resolveEnv(root) {
  const fromVar = process.env.BRUNO_ENV;
  if (fromVar) return fromVar === 'none' ? null : fromVar;
  return readState()[root] || null;
}

function prettyBody(data) {
  if (data === undefined || data === null || data === '') return dim('(empty body)');
  if (typeof data === 'object') return JSON.stringify(data, null, 2);
  const s = String(data);
  try {
    return JSON.stringify(JSON.parse(s), null, 2);
  } catch {
    return s;
  }
}

// ---------- Markdown response view ----------

const cell = (v) => String(v ?? '').replace(/\|/g, '\\|').replace(/\r?\n/g, ' ');
const MAX_BODY = 200 * 1024;

function fmtSize(n) {
  if (typeof n !== 'number') return '?';
  if (n < 1024) return `${n} o`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} Ko`;
  return `${(n / 1024 / 1024).toFixed(1)} Mo`;
}

function bodyLang(headers) {
  const ct = Object.entries(headers || {}).find(([k]) => k.toLowerCase() === 'content-type')?.[1] || '';
  if (/json/i.test(ct)) return 'json';
  if (/html/i.test(ct)) return 'html';
  if (/xml/i.test(ct)) return 'xml';
  if (/javascript/i.test(ct)) return 'javascript';
  return 'text';
}

function fence(text, lang) {
  let s = String(text);
  let note = '';
  if (s.length > MAX_BODY) {
    note = `\n_Body tronqué à ${fmtSize(MAX_BODY)} — complet dans \`${LAST_RESPONSE}\`._\n`;
    s = s.slice(0, MAX_BODY);
  }
  const ticks = s.includes('```') ? '````' : '```';
  return `${ticks}${lang}\n${s}\n${ticks}\n${note}`;
}

function rawBody(data) {
  if (typeof data === 'object') return JSON.stringify(data, null, 2);
  try {
    return JSON.stringify(JSON.parse(data), null, 2);
  } catch {
    return String(data);
  }
}

function table(head, rows) {
  if (!rows.length) return '';
  return `| ${head.join(' | ')} |\n|${head.map(() => '---').join('|')}|\n${rows.map((r) => `| ${r.map(cell).join(' | ')} |`).join('\n')}\n`;
}

function statusIcon(r) {
  const s = r.response?.status;
  if (r.error || r.status === 'error' || typeof s !== 'number') return '❌';
  if (r.status === 'fail' || s >= 400) return '❌';
  if (s >= 300) return '↪️';
  return '✅';
}

function requestSection(r) {
  const req = r.request || {};
  const res = r.response || {};
  const out = [];
  const status = typeof res.status === 'number' ? `${res.status} ${res.statusText || ''}`.trim() : 'Erreur';
  out.push(`## ${statusIcon(r)} ${req.method || ''} ${r.name || r.path}`);
  out.push(`\`${req.method || ''} ${req.url || ''}\``);
  out.push(table(['Statut', 'Temps', 'Taille', 'Fichier'], [[`**${status}**`, `${res.responseTime ?? '?'} ms`, fmtSize(res.size), r.path || '']]));
  if (r.error) out.push(`> **Erreur :** ${cell(r.error)}\n`);

  out.push('### Réponse');
  if (res.data !== undefined && res.data !== null && res.data !== '') {
    out.push(fence(rawBody(res.data), bodyLang(res.headers)));
  } else {
    out.push('_Body vide._\n');
  }

  const checks = [
    ...(r.assertionResults || []).map((a) => [a.status === 'pass' ? '✅' : '❌', 'assert', `${a.lhsExpr} ${a.rhsExpr}`, a.error || '']),
    ...[...(r.preRequestTestResults || []), ...(r.testResults || []), ...(r.postResponseTestResults || [])].map((t) => [
      t.status === 'pass' ? '✅' : '❌',
      'test',
      t.description,
      t.error || '',
    ]),
  ];
  if (checks.length) {
    out.push('### Tests et assertions');
    out.push(table(['', 'Type', 'Description', 'Erreur'], checks));
  }

  if (res.headers && Object.keys(res.headers).length) {
    out.push('### Headers de réponse');
    out.push(table(['Header', 'Valeur'], Object.entries(res.headers)));
  }

  out.push('### Requête envoyée');
  try {
    const u = new URL(req.url);
    const params = [...u.searchParams.entries()];
    if (params.length) {
      out.push('**Query params**\n');
      out.push(table(['Nom', 'Valeur'], params));
    }
  } catch {}
  const reqHeaders = Object.entries(req.headers || {}).filter(([, v]) => v !== null && v !== undefined);
  if (reqHeaders.length) {
    out.push('**Headers**\n');
    out.push(table(['Header', 'Valeur'], reqHeaders));
  }
  if (req.data !== undefined && req.data !== null && req.data !== '') {
    out.push('**Body**\n');
    out.push(fence(rawBody(req.data), bodyLang(req.headers)));
  }
  return out.join('\n\n');
}

function writeMarkdown(results, ctx) {
  const now = new Date().toLocaleString('fr-FR');
  const parts = [];
  const title = results.length === 1 ? results[0].name || results[0].path : `${results.length} requêtes`;
  parts.push(`# Bruno · ${title}`);
  parts.push(`_${now} · environnement \`${ctx.env || 'défaut de la collection'}\` · ${ctx.root}_\n`);
  if (results.length > 1) {
    parts.push(
      table(
        ['', 'Requête', 'Statut', 'Temps'],
        results.map((r) => [
          statusIcon(r),
          `${r.request?.method || ''} ${r.name || r.path}`,
          typeof r.response?.status === 'number' ? r.response.status : 'Erreur',
          `${r.response?.responseTime ?? '?'} ms`,
        ]),
      ),
    );
  }
  parts.push(results.map(requestSection).join('\n\n---\n\n'));
  fs.writeFileSync(RESPONSE_MD, parts.join('\n\n') + '\n');
}

function openInZed(file) {
  const r = spawnSync('zed', ['-a', file], { stdio: 'ignore' });
  if (r.error) console.log(dim(`(zed CLI introuvable : ouvre ${file} à la main)`));
}

function printResponses(reportFile, ctx = {}) {
  let report;
  try {
    report = JSON.parse(fs.readFileSync(reportFile, 'utf8'));
  } catch {
    return;
  }
  const results = (Array.isArray(report) ? report : [report]).flatMap((it) => it.results || []);
  if (results.length && process.env.BRUNO_ZED_VIEW !== '0') {
    const existed = fs.existsSync(RESPONSE_MD);
    writeMarkdown(results, ctx);
    const mode = process.env.BRUNO_ZED_OPEN || 'first';
    if (mode === 'always' || (mode === 'first' && !existed)) openInZed(RESPONSE_MD);
  }
  if (process.env.BRUNO_ZED_BODY === '0') return;
  const showHeaders = process.env.BRUNO_ZED_HEADERS === '1';
  let last = null;

  for (const r of results) {
    const req = r.request || {};
    const res = r.response || {};
    console.log('');
    console.log(bold(cyan(`━━ ${r.name || r.path} `)) + dim(r.path || ''));
    console.log(`${bold(req.method || '?')} ${req.url || ''}`);
    if (r.error) console.log(red(`Error: ${r.error}`));
    if (typeof res.status === 'number') {
      const col = res.status >= 400 ? red : res.status >= 300 ? yellow : green;
      console.log(`${col(bold(`${res.status} ${res.statusText || ''}`))}  ${dim(`${res.responseTime ?? '?'} ms · ${res.size ?? '?'} B`)}`);
    }
    if (showHeaders && res.headers) {
      for (const [k, v] of Object.entries(res.headers)) console.log(`${dim(k + ':')} ${v}`);
    }
    if ('data' in res) console.log(prettyBody(res.data));
    last = { name: r.name, path: r.path, request: req, response: res };
  }

  if (last) {
    fs.writeFileSync(LAST_RESPONSE, JSON.stringify(last, null, 2));
    console.log('');
    console.log(dim(`Last response saved to ${LAST_RESPONSE}`));
  }
}

function runBru(target, { recursive }, extra) {
  const found = findCollectionRoot(target);
  if (!found) {
    die(`No Bruno collection found for ${target}\n  (looked for bruno.json or opencollection.yml in parent folders)`);
  }
  const { root } = found;
  const env = resolveEnv(root);

  const args = ['run', path.resolve(target)];
  if (recursive) args.push('-r');
  if (env && !extra.includes('--env')) args.push('--env', env);
  fs.mkdirSync(STATE_DIR, { recursive: true });
  try { fs.unlinkSync(LAST_REPORT); } catch {}
  args.push('--reporter-json', LAST_REPORT, ...extra);

  console.log(dim(`collection: ${root}`));
  console.log(dim(`environment: ${env || '(collection default)'}`));
  console.log(dim(`$ bru ${args.map((a) => (/\s/.test(a) ? JSON.stringify(a) : a)).join(' ')}`));
  console.log('');

  const r = spawnSync('bru', args, { cwd: root, stdio: 'inherit' });
  if (r.error) {
    if (r.error.code === 'ENOENT') die('`bru` not found. Install it with: npm i -g @usebruno/cli');
    die(r.error.message);
  }
  printResponses(LAST_REPORT, { env, root });
  process.exit(r.status ?? 1);
}

async function chooseEnv(target) {
  const found = findCollectionRoot(target);
  if (!found) die(`No Bruno collection found for ${target}`);
  const { root, format } = found;
  const envs = listEnvironments(root, format);
  const state = readState();
  const current = state[root] || null;

  console.log(bold(`Collection: ${root}`));
  if (!envs.length) {
    console.log(yellow('No environment in environments/.'));
    return;
  }
  const options = ['(none — collection default)', ...envs];
  options.forEach((o, i) => {
    const active = (i === 0 && !current) || o === current;
    console.log(`  ${active ? green('●') : ' '} ${bold(i)}) ${o}`);
  });

  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const answer = await new Promise((res) => rl.question('\nNumber (Enter = keep): ', res));
  rl.close();
  if (answer.trim() === '') return console.log(dim('Unchanged.'));
  const idx = Number(answer);
  if (!Number.isInteger(idx) || idx < 0 || idx >= options.length) die('Invalid choice');
  if (idx === 0) delete state[root];
  else state[root] = options[idx];
  writeState(state);
  console.log(green(`✓ Environment: ${idx === 0 ? '(collection default)' : options[idx]}`));
}

async function main() {
  const argv = process.argv.slice(2);
  const sep = argv.indexOf('--');
  const extra = sep >= 0 ? argv.slice(sep + 1) : [];
  const [cmd, target] = sep >= 0 ? argv.slice(0, sep) : argv;

  switch (cmd) {
    case 'run':
      if (!target) die('Usage: bruno-zed run <file>');
      if (!fs.existsSync(target)) die(`File not found: ${target}`);
      return runBru(target, { recursive: false }, extra);
    case 'folder': {
      if (!target) die('Usage: bruno-zed folder <path>');
      const dir = fs.statSync(target).isDirectory() ? target : path.dirname(target);
      return runBru(dir, { recursive: true }, extra);
    }
    case 'collection': {
      if (!target) die('Usage: bruno-zed collection <path>');
      const found = findCollectionRoot(target);
      if (!found) die(`No Bruno collection found for ${target}`);
      return runBru(found.root, { recursive: true }, extra);
    }
    case 'env':
      return chooseEnv(target || process.cwd());
    case 'view':
      if (!fs.existsSync(RESPONSE_MD)) die('No response yet. Run a request first.');
      openInZed(RESPONSE_MD);
      console.log(`Opened ${RESPONSE_MD}\nZed: ctrl-shift-p → "markdown: open preview to the side"`);
      return;
    case 'last':
      if (!fs.existsSync(LAST_RESPONSE)) die('No response yet.');
      console.log(fs.readFileSync(LAST_RESPONSE, 'utf8'));
      return;
    default:
      console.log(fs.readFileSync(__filename, 'utf8').split('\n').slice(1, 17).map((l) => l.replace(/^\/\/ ?/, '')).join('\n'));
      process.exit(cmd ? 1 : 0);
  }
}

main();
